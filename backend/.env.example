PORT=5000
NODE_ENV=development

DATABASE_URL="mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/nordmark_db?ssl=true&authSource=admin&retryWrites=true&w=majority"

# If mongodb+srv:// times out, use the standard connection string from Atlas:
# Connect → Drivers → "Standard connection string"

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Comma-separated frontend URLs allowed for CORS (no trailing slash)
CLIENT_URL=http://localhost:3000

# Production on Vercel (recommended):
# NODE_ENV=production
# CLIENT_URL=https://real-state-zeta-six.vercel.app
# ALLOW_VERCEL_PREVIEWS=true   (default on Vercel — allows any *.vercel.app frontend)

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
